---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getPosts, neighbours, postPath, type Post } from '../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((post) => {
    const { prev, next } = neighbours(posts, post);

    return {
      // Old Hexo permalink: /:year/:month/:day/:title/  where :title is the file name.
      // postPath() 统一按北京时间取年月日，构建机时区变了网址也不会变。
      params: { slug: postPath(post).slice(1, -1) },
      props: { post, prev, next },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content />
</PostLayout>