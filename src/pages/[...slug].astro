---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getPosts, neighbours, type Post } from '../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((post) => {
    const d = post.data.date;
    const y = String(d.getUTCFullYear());
    const m = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');

    const { prev, next } = neighbours(posts, post);

    return {
      // Old Hexo permalink: /:year/:month/:day/:title/  where :title is the file name.
      params: { slug: `${y}/${m}/${day}/${post.data.slug}` },
      props: { post, prev, next },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content />
</PostLayout>