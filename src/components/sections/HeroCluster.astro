---
/**
 * HeroCluster.astro — the top of the homepage.
 *
 * HANDOFF §4: the desk widgets do not live at the bottom of the bento any more.
 * The personal name sits dead centre, and the widgets + the cat card are
 * scattered around it in a ring, at uneven sizes, angles and baselines.
 * Every position comes from src/lib/widgets.ts so the scatter is data.
 */
import { Image } from 'astro:assets';
import catHero from '../../assets/cat-hero.webp';
import lake from '../../assets/lake.webp';
import { site } from '../../lib/site';
import { deskWidgets } from '../../lib/widgets';
import WidgetHost from '../widgets/WidgetHost.astro';

const quotes = site.quotes.map((q) => `${q.text}##${q.from}`).join('|||');
---

<section class="hero" data-hero data-parallax aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <Image class="hero__photo" src={lake} alt="" data-pl="photo" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" />
    <span class="hero__veil"></span>
    <span class="hero__tint"></span>
    <span class="hero__grain"></span>
  </div>

  <span class="hero__aura a1" data-pl="aura1" aria-hidden="true"></span>
  <span class="hero__aura a2" data-pl="aura2" aria-hidden="true"></span>
  <span class="hero__aura a3" data-pl="aura3" aria-hidden="true"></span>
  <span class="hero__grid" data-pl="grid" aria-hidden="true"></span>
  <span class="hero__beam" data-pl="beam" aria-hidden="true"></span>

  <div class="hero__stage">
    <div class="hero__copy" data-hero-copy data-pl="copy">
      <h1 class="hero__title" id="hero-title">
        {site.hero.hello}<br />
        {site.hero.iam} <span class="hero__name">{site.name}</span>
      </h1>

      <p class="hero__lead">{site.hero.lead}</p>

      <ul class="hero__facts">
        {site.hero.facts.map((fact) => <li>{fact}</li>)}
      </ul>

      <div class="hero__actions">
        <a class="btn btn--solid" href="/archive/">翻翻日志</a>
        <a class="btn btn--ghost" href="/about/">认识一下</a>
      </div>
    </div>

    <aside class="hero__pet" data-hero-pet data-pl="pet" style="--x:524px; --y:30px; --rot:3deg">
      <article class="petcard" data-tilt>
        <span class="petcard__glow" aria-hidden="true"></span>
        <div class="petcard__wrap">
          <Image class="petcard__cat" src={catHero} alt="一只趴在窗边的猫" widths={[260, 420]} sizes="260px" loading="eager" />
          <span class="petcard__sp s1" aria-hidden="true">✦</span>
          <span class="petcard__sp s2" aria-hidden="true">✧</span>
          <span class="petcard__sp s3" aria-hidden="true">✦</span>
        </div>
        <div class="petcard__bubble" role="status" aria-live="polite" data-quote data-quote-fallback={quotes}>
          <p class="petcard__qtext" data-quote-text>今天的月亮也很好看。</p>
          <p class="petcard__qfrom" data-quote-from></p>
          <span class="petcard__tail" aria-hidden="true"></span>
        </div>
      </article>
    </aside>

    <div class="hero__ring" role="group" aria-label="桌面小物件">
      {deskWidgets.map((widget) => <WidgetHost widget={widget} />)}
    </div>
  </div>

  <p class="hero__hint" aria-hidden="true">
    <span class="hero__hintdot"></span>往下看看
  </p>

  <button class="hero__gyro" type="button" data-gyro hidden>
    <span class="hero__gyrodot" aria-hidden="true"></span>
    <span data-gyro-label>轻晃手机，画面会跟着动</span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(960px, 100svh);
    padding-block: calc(var(--header-h) + var(--s-6)) var(--s-8);
    display: grid;
    place-items: center;
    overflow: clip;
  }

  /* ---------- background ---------- */
  .hero__bg { position: absolute; inset: -10% -6%; z-index: -3; }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.7) brightness(1.08) blur(1.5px);
    transform: translate3d(var(--plx, 0px), var(--ply, 0px), 0) scale(var(--pls, 1.05));
    will-change: transform;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 88% at 50% 42%, rgba(255, 253, 249, .34) 0%, rgba(255, 253, 249, .80) 58%, var(--paper) 94%);
  }
  .hero__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(211, 231, 255, .30), transparent 46%, rgba(255, 216, 138, .24));
    mix-blend-mode: multiply;
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: .14;
    background-image: radial-gradient(rgba(52, 56, 63, .5) .5px, transparent .5px);
    background-size: 3px 3px;
  }

  /* ---------- atmosphere ---------- */
  .hero__aura {
    position: absolute;
    z-index: -2;
    border-radius: 50%;
    filter: blur(46px);
    transform: translate3d(var(--plx, 0px), var(--ply, 0px), 0);
    will-change: transform;
  }
  .hero__aura.a1 {
    width: 44vmin; height: 44vmin; left: 4%; top: 6%;
    background: radial-gradient(circle, rgba(127, 199, 169, .50), transparent 68%);
  }
  .hero__aura.a2 {
    width: 50vmin; height: 50vmin; right: 1%; top: 14%;
    background: radial-gradient(circle, rgba(255, 187, 160, .44), transparent 68%);
  }
  .hero__aura.a3 {
    width: 40vmin; height: 40vmin; left: 32%; bottom: 2%;
    background: radial-gradient(circle, rgba(222, 219, 246, .54), transparent 70%);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .26;
    background-image:
      linear-gradient(rgba(52, 56, 63, .07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(52, 56, 63, .07) 1px, transparent 1px);
    background-size: 68px 68px;
    mask-image: radial-gradient(circle at 50% 44%, #000 0%, transparent 70%);
    transform: translate3d(var(--plx, 0px), var(--ply, 0px), 0);
    will-change: transform;
  }
  .hero__beam {
    position: absolute;
    z-index: -2;
    top: -30%;
    left: 46%;
    width: 32vmin;
    height: 150%;
    background: linear-gradient(to bottom, rgba(255, 255, 255, .5), transparent 70%);
    filter: blur(24px);
    transform: rotate(24deg) translate3d(var(--plx, 0px), var(--ply, 0px), 0);
    will-change: transform;
  }

  /* ---------- the centred stage ---------- */
  .hero__stage {
    position: relative;
    width: 100%;
    --rs: 1;
    min-height: min(820px, calc(100svh - var(--header-h) - 96px));
    display: grid;
    place-items: center;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    width: min(34rem, 100% - var(--s-6));
    text-align: center;
    transform: translate3d(var(--plx, 0px), var(--ply, 0px), 0);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: clamp(2.6rem, 6.4vw, 5rem);
    line-height: 1.16;
    letter-spacing: -.02em;
    text-wrap: balance;
  }
  .hero__name {
    position: relative;
    color: var(--mint-deep);
    padding-inline: 2px;
  }
  .hero__name::after {
    content: '';
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: .04em;
    height: .32em;
    z-index: -1;
    border-radius: var(--r-pill);
    background: var(--mint-soft);
  }

  .hero__lead {
    margin: var(--s-4) auto 0;
    max-width: 28rem;
    color: var(--ink-soft);
    font-size: var(--fs-base);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__facts li {
    padding: 2px 12px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .62);
    border: 1px solid var(--glass-line);
    font-size: var(--fs-xs);
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--s-6);
    border-radius: var(--r-pill);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--fs-sm);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .btn--solid { background: var(--mint-deep); color: #fff; box-shadow: var(--shadow-soft); }
  .btn--ghost { background: var(--glass-strong); color: var(--ink); border: 1px solid var(--glass-line); backdrop-filter: var(--glass-blur); }
  .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-float); }

  /* ---------- pet card, parked on the ring ---------- */
  .hero__pet {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: clamp(250px, 22vw, 330px);
    transform:
      translate(-50%, -50%)
      translate(calc(var(--x) * var(--rs, 1)), calc(var(--y) * var(--rs, 1)))
      rotate(var(--rot))
      translate3d(var(--plx, 0px), var(--ply, 0px), 0);
    will-change: transform;
  }
  .petcard {
    --rx: 0deg; --ry: 0deg; --sx: 0; --sy: 0;
    position: relative;
    padding: var(--s-4);
    border-radius: var(--r-xl);
    background: var(--glass-strong);
    border: 1px solid var(--glass-line);
    box-shadow: var(--shadow-float);
    backdrop-filter: var(--glass-blur);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) translate3d(calc(var(--sx) * 4px), calc(var(--sy) * 4px), 0);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .petcard__glow {
    position: absolute;
    inset: -18%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 216, 138, .55), transparent 66%);
    filter: blur(18px);
  }
  .petcard__wrap { position: relative; }
  .petcard__cat {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--r-lg);
    transform: translateZ(30px);
  }
  .petcard__sp { position: absolute; color: var(--sun); font-size: var(--fs-sm); transform: translateZ(50px); }
  .petcard__sp.s1 { top: 6%; left: -6%; }
  .petcard__sp.s2 { top: 42%; right: -8%; color: var(--mint); }
  .petcard__sp.s3 { bottom: 4%; left: 12%; font-size: var(--fs-xs); }

  .petcard__bubble {
    position: relative;
    margin-top: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--paper);
    border: 1px solid var(--line);
    cursor: pointer;
    transform: translateZ(20px);
  }
  .petcard__qtext { margin: 0; font-size: var(--fs-xs); line-height: 1.7; color: var(--ink); }
  .petcard__qfrom { margin: 4px 0 0; font-size: 11px; color: var(--ink-faint); text-align: right; }
  .petcard__qfrom:empty { display: none; }
  .petcard__tail {
    position: absolute;
    top: -6px;
    left: 24px;
    width: 10px;
    height: 10px;
    background: var(--paper);
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
    transform: rotate(45deg);
  }

  /* ---------- scattered desk ---------- */
  .hero__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .hero__ring > :global(*) { pointer-events: auto; }

  .hero__hint {
    position: absolute;
    left: 50%;
    bottom: var(--s-5);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    font-size: var(--fs-xs);
    letter-spacing: .18em;
    color: var(--ink-faint);
  }
  .hero__hintdot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--mint);
    box-shadow: 0 0 0 4px var(--mint-soft);
  }

  /* the gyro prompt only ever appears on a touch device that has not yet
     handed over orientation readings — see initGyro() in effects/motion.ts.
     It floats at the bottom of the viewport (not inside the hero) so the
     widget ring can never cover it. */
  .hero__gyro {
    position: fixed;
    left: 50%;
    bottom: calc(var(--s-5) + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--paper);
    box-shadow: var(--sh-2);
    font: inherit;
    font-size: var(--fs-xs);
    letter-spacing: .04em;
    color: var(--ink-soft);
    cursor: pointer;
    animation: gyro-nudge 3.2s ease-in-out infinite;
  }
  .hero__gyro[hidden] { display: none; }
  .hero__gyro:hover {
    border-color: var(--mint);
    color: var(--ink);
  }
  .hero__gyrodot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--mint);
    box-shadow: 0 0 0 3px var(--mint-soft);
  }
  @keyframes gyro-nudge {
    0%, 100% { transform: translateX(-50%) rotate(-1.4deg); }
    50% { transform: translateX(-50%) rotate(1.4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__gyro { animation: none; }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1460px) { .hero__stage { --rs: .92; } }
  @media (max-width: 1360px) { .hero__stage { --rs: .84; } }
  @media (max-width: 1280px) { .hero__stage { --rs: .76; } }
  @media (max-width: 1180px) {
    .hero { min-height: auto; padding-block: calc(var(--header-h) + var(--s-6)) var(--s-8); }
    .hero__stage {
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--s-6);
    }
    .hero__pet {
      position: static;
      width: min(320px, 100%);
      /* keep the card's own angle on narrow screens — the tilt is part of the
         "pinned to a corkboard" look, not a desktop-only flourish */
      transform: rotate(var(--rot));
      margin-top: var(--s-7);
      justify-self: center;
    }

    /* The scatter cannot survive a narrow screen. Instead of an overlapping
       strip (which let the polaroid slide under the note) the desk becomes a
       plain two-column grid: no negative margins, no collision — but every
       widget keeps its own free tilt angle. */
    .hero__ring {
      position: static;
      width: min(36rem, 100% - var(--s-6));
      height: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: center;
      align-items: start;
      gap: var(--s-4) var(--s-3);
      margin-top: var(--s-6);
      pointer-events: auto;
    }
    .hero__ring :global(.w) {
      position: static;
      display: flex;
      justify-content: center;
      width: 100%;
      transform: rotate(var(--rot)) scale(var(--scale));
    }
    .hero__ring :global(.w--tag),
    .hero__ring :global(.w--search) { display: none; }
  }
  @media (max-width: 620px) {
    .hero__ring {
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
      /* the polaroid's photo slides out ~88px below its box — reserve room
         so .hero { overflow: clip } never cuts it off on phones */
      padding-bottom: 96px;
    }
    /* one widget per row: there is room for the full angle again */
    .hero__ring :global(.w) { transform: rotate(var(--rot)) scale(var(--scale)); }
  }
  @media (max-width: 620px) {
    .hero__title { font-size: clamp(2rem, 9.5vw, 2.9rem); }
    .hero__lead { font-size: var(--fs-sm); }
  }
</style>