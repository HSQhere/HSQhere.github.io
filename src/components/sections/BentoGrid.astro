---
/**
 * BentoGrid.astro — the "从这里进去" section under the hero.
 * Pure CSS grid, no fixed coordinates; every card is a plain link.
 *
 * 第一张卡是搜索（真的能搜，不是跳转按钮）；最后一张是成长轨迹，
 * 用一条 S 形曲线把整条时间线上的文章累计起来画出来。
 */
import { Image } from 'astro:assets';
import lakeSm from '../../assets/lake-sm.webp';
import { site } from '../../lib/site';
import { getEntry } from 'astro:content';
import { getPosts, postPath, collectTags, readingTime } from '../../lib/posts';
import { monthText, yearOf } from '../../lib/datetime';
import { parseTasks, taskStats } from '../../lib/plan';

const posts = await getPosts();
const tags = [...collectTags(posts).entries()].sort((a, b) => b[1].length - a[1].length).slice(0, 4);
const latest = posts.slice(0, 3);
const total = posts.length;

// Writing rhythm: posts per month, used to fill the tall log card.
const months = new Map<string, number>();
for (const p of posts) {
  const d = p.data.date;
  const key = yearOf(d) + '-' + monthText(d);
  months.set(key, (months.get(key) ?? 0) + 1);
}
const rhythm = [...months.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const rhythmMax = Math.max(1, ...rhythm.map(([, n]) => n));

const planGroups = parseTasks((await getEntry('posts', 'To-Do'))?.body ?? '');
const stats = taskStats(planGroups);
const pct = stats.percent;
const planTop = planGroups.flatMap((g) => g.tasks).slice(0, 4);

/* ---------------------------------------------------------------- *
 * 成长轨迹 —— 直接从文章时间线里算，不写死任何数字。
 *   曲线本身是一条逻辑斯蒂（S）形：起步慢 → 中段陡 → 后段趋平。
 *   节点是真实阶段，位置按阶段顺序落在 S 上，标签里写真实月份和篇数。
 * ---------------------------------------------------------------- */

const ymOf = (d: Date) => `${yearOf(d)}-${monthText(d)}`;

const perMonth = new Map<string, number>();
for (const p of posts) {
  const k = ymOf(p.data.date);
  perMonth.set(k, (perMonth.get(k) ?? 0) + 1);
}
const monthKeys = [...perMonth.keys()].sort();

const phases = site.growthPhases.map((ph) => {
  const inside = posts.filter((p) => {
    const k = ymOf(p.data.date);
    return k >= ph.from && k <= ph.to;
  });
  const top = [...inside].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
  return { ...ph, count: inside.length, sample: top?.data.title ?? '' };
});

/* ---- S 曲线几何（viewBox 单位，preserveAspectRatio="none" 铺满卡片） ---- */
const W = 1000;
const H = 480;
const padL = 72;
const padR = 72;
const padT = 120;
const padB = 110;
const iw = W - padL - padR;
const ih = H - padT - padB;

/** 逻辑斯蒂：t∈[0,1] → 0..1，k 越大中段越陡 */
const K = 8.5;
const sig = (t: number) => 1 / (1 + Math.exp(-K * (t - 0.5)));
const sig0 = sig(0);
const sig1 = sig(1);
const norm = (t: number) => (sig(t) - sig0) / (sig1 - sig0);

const xOf = (t: number) => padL + t * iw;
const yOf = (v: number) => padT + (1 - v) * ih;

/** 采样成折线 —— 逻辑斯蒂本身足够顺，采样比贝塞尔更好控 */
const SAMPLES = 120;
const curvePts = Array.from({ length: SAMPLES + 1 }, (_, i) => {
  const t = i / SAMPLES;
  return { x: xOf(t), y: yOf(norm(t)) };
});
const curvePath = curvePts
  .map((p, i) => `${i ? 'L' : 'M'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
  .join(' ');
const areaPath = `${curvePath} L ${xOf(1).toFixed(1)} ${(H - padB).toFixed(1)} L ${xOf(0).toFixed(1)} ${(H - padB).toFixed(1)} Z`;

/** 阶段落在 S 上的位置：按顺序均分，留出两端余量 */
const marks = phases.map((p, i) => {
  const t = phases.length === 1 ? 0.5 : 0.1 + (i / (phases.length - 1)) * 0.8;
  return {
    ...p,
    xPct: (xOf(t) / W) * 100,
    yPct: (yOf(norm(t)) / H) * 100,
    side: i % 2 === 0 ? 'up' : 'down',
    anchor: i === 0 ? 'start' : i === phases.length - 1 ? 'end' : 'mid',
  };
});

/** 曲线上的等分刻度（只画短线，不写数字） */
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => ({
  x: xOf(t),
  y: yOf(norm(t)),
  base: H - padB,
}));

const firstMonth = monthKeys[0] ?? '';
const lastMonth = monthKeys[monthKeys.length - 1] ?? '';
const spanLabel = `${firstMonth.slice(2).replace('-', '.')} – ${lastMonth.slice(2).replace('-', '.')}`;
---

<section class="bento" aria-labelledby="bento-title">
  <header class="bento__head" data-reveal="0">
    <p class="bento__kicker">BENTO · 板块</p>
    <h2 class="bento__title" id="bento-title">从这里进去</h2>
    <p class="bento__now" data-clock-time>--:--</p>
  </header>

  <div class="bento__grid">
    <!-- 搜索 —— 第一张卡，真的能搜 -->
    <article class="card card--search" data-reveal="1">
      <div class="search__top">
        <p class="card__badge">搜索</p>
        <p class="search__hint">{total} 篇 · 标题、标签、正文都能搜</p>
      </div>
      <form class="search__form" action="/search/" method="get" role="search" data-search-form>
        <span class="search__icon" aria-hidden="true">⌕</span>
        <label class="u-visually-hidden" for="home-q">搜索文章</label>
        <input
          class="search__input"
          id="home-q"
          name="q"
          type="search"
          placeholder="想找什么？电控、SVPWM、路径规划…"
          autocomplete="off"
          spellcheck="false"
          data-search-input
        />
        <kbd class="search__kbd" aria-hidden="true">⌘K</kbd>
        <button class="search__go" type="submit">搜索</button>
      </form>
      <ul class="search__hits" data-search-hits hidden></ul>
      <ul class="search__tags">
        {tags.map(([name, list]) => (
          <li>
            <a href={`/search/?q=${encodeURIComponent(name)}`}>{name} <span>{list.length}</span></a>
          </li>
        ))}
      </ul>
    </article>

    <!-- 日志 -->
    <article class="card card--log" data-reveal="2">
      <p class="card__badge">日志</p>
      <p class="card__big">{total} <em>篇</em></p>
      <p class="card__desc">电控、算法、机器人，还有一些不太好分类的东西。</p>
      <ul class="card__tags">
        {tags.map(([name, list]) => (
          <li><a href={`/tags/${encodeURIComponent(name)}/`}>{name} <span>{list.length}</span></a></li>
        ))}
      </ul>
      <div class="card__rhythm" aria-hidden="true">
        {rhythm.map(([key, n]) => (
          <span class="rhythm" style={`--h:${Math.round((n / rhythmMax) * 100)}%`}>
            <i></i>
            <em>{key.slice(5)}</em>
          </span>
        ))}
      </div>
      <p class="card__rhythmlabel">{rhythm.length} 个月的写作节奏</p>
      <ul class="card__latest">
        {latest.map((p) => (
          <li>
            <a href={postPath(p)}>{p.data.title}</a>
            <span>{readingTime(p.body ?? '')} 分钟</span>
          </li>
        ))}
      </ul>
      <a class="card__go" href="/archive/">进入归档 →</a>
    </article>

    <!-- 图库 -->
    <article class="card card--gallery" data-reveal="3">
      <a class="card__shot" href="/gallery/">
        <Image src={lakeSm} alt="山与湖" widths={[320, 640]} sizes="(max-width: 620px) 100vw, 40vw" loading="lazy" />
      </a>
      <p class="card__badge">图库</p>
      <p class="card__desc">用色彩和明暗记录的一瞬间。</p>
      <a class="card__go" href="/gallery/">去看看 →</a>
    </article>

    <!-- 计划 -->
    <article class="card card--plan" data-reveal="4">
      <p class="card__badge">计划</p>
      <ul class="card__tasks">
        {planTop.map((t) => (
          <li class:list={[`is-${t.status}`]}>{t.title}</li>
        ))}
      </ul>
      <div class="card__progress"><i data-bar={pct}></i></div>
      <p class="card__pct">{pct}% · {stats.done + stats.doing + stats.canceled}/{stats.total}</p>
      <a class="card__go" href="/plan/">看全部 →</a>
    </article>

    <!-- 关于 -->
    <article class="card card--about" data-reveal="5">
      <p class="card__badge">关于</p>
      <p class="card__desc">{site.author.bio}</p>
      <ul class="card__meta">
        <li>📍 广州</li>
        <li>🎓 华南理工</li>
        <li>🛠 机器人</li>
      </ul>
      <a class="card__go" href="/about/">认识一下 →</a>
    </article>

    <!-- 成长轨迹 —— S 形曲线 -->
    <article class="card card--path" data-reveal="6">
      <header class="path__head">
        <p class="card__badge">成长轨迹</p>
        <h3 class="path__title">从第一篇到第 {total} 篇</h3>
        <p class="path__sub">{spanLabel} · 按月度累计，越陡的地方写得越密</p>
      </header>

      <!-- 桌面：真正的 S 曲线 -->
      <div class="path__chart" aria-hidden="true">
        <svg class="path__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" focusable="false">
          <defs>
            <linearGradient id="growth-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--mint)" stop-opacity=".28" />
              <stop offset="100%" stop-color="var(--mint)" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="growth-stroke" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--mint)" />
              <stop offset="55%" stop-color="var(--mint-deep)" />
              <stop offset="100%" stop-color="var(--peach)" />
            </linearGradient>
          </defs>

          {ticks.map((t) => (
            <line class="path__tick" x1={t.x} y1={t.base} x2={t.x} y2={t.base + 10} />
          ))}
          <line class="path__base" x1={xOf(0)} y1={H - padB} x2={xOf(1)} y2={H - padB} />

          <path class="path__area" d={areaPath} />
          <path class="path__curve" d={curvePath} pathLength="1" />
        </svg>

        <!-- 轴标签用 HTML 叠上去，窄卡片上也不会被 SVG 缩放吃掉 -->
        <div class="path__axis">
          <span class="path__axis-from" style={`--l:${(xOf(0) / W) * 100}%`}>{firstMonth.slice(2).replace('-', '.')}</span>
          <span class="path__axis-to" style={`--l:${(xOf(1) / W) * 100}%`}>{lastMonth.slice(2).replace('-', '.')}</span>
          <span class="path__axis-y0" style={`--t:${((H - padB) / H) * 100}%`}>0</span>
          <span class="path__axis-y1" style={`--t:${(padT / H) * 100}%`}>{total} 篇</span>
        </div>

        <ol class="path__marks">
          {marks.map((m, i) => (
            <li
              class:list={['mark', `mark--${m.side}`, `mark--${m.anchor}`]}
              style={`--x:${m.xPct}%;--y:${m.yPct}%;--i:${i}`}
            >
              <span class="mark__dot"></span>
              <span class="mark__card">
                <b class="mark__label">{m.label}</b>
                <i class="mark__range">{m.range}</i>
                <em class="mark__count">{m.count} 篇</em>
              </span>
            </li>
          ))}
        </ol>
      </div>

      <!-- 手机：竖排时间线，同一份数据 -->
      <ol class="path__list">
        {phases.map((p, i) => (
          <li class="grow" style={`--i:${i}`}>
            <span class="grow__dot" aria-hidden="true"></span>
            <div class="grow__body">
              <p class="grow__head"><b>{p.label}</b><i>{p.range}</i></p>
              <p class="grow__note">{p.note}</p>
            </div>
            <span class="grow__count">{p.count} 篇</span>
          </li>
        ))}
      </ol>

      <p class="path__foot">数据来自归档里 {total} 篇文章的发布时间 · <a href="/archive/">看全部 →</a></p>
    </article>
  </div>
</section>

<script>
  import { register, addCleanup } from '../../effects/page';

  /* 首页内联搜索：第一次敲字才去拉索引，不拖慢首屏 */
  type Hit = {
    title: string;
    url: string;
    date: string;
    tags: string[];
    categories: string[];
    excerpt: string;
  };

  register('bento:search', () => {
    const form = document.querySelector<HTMLFormElement>('[data-search-form]');
    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    const hitsBox = document.querySelector<HTMLUListElement>('[data-search-hits]');
    if (!form || !input || !hitsBox) return;

    let index: Hit[] | null = null;
    let pending: Promise<Hit[]> | null = null;

    const load = () => {
      if (index) return Promise.resolve(index);
      if (!pending) {
        pending = fetch('/search-index.json')
          .then((r) => r.json() as Promise<Hit[]>)
          .then((data) => (index = data))
          .catch(() => (index = [] as Hit[]));
      }
      return pending;
    };

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const mark = (text: string, term: string) => {
      const safe = esc(text);
      if (!term) return safe;
      const re = new RegExp(term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      return safe.replace(re, (m) => `<mark>${m}</mark>`);
    };

    const render = (hits: Hit[], term: string) => {
      if (!hits.length) {
        hitsBox.hidden = false;
        hitsBox.innerHTML = `<li class="sh__empty">没找到「${esc(term)}」，回车去搜索页试试。</li>`;
        return;
      }
      hitsBox.hidden = false;
      hitsBox.innerHTML = hits
        .map(
          (h) => `<li class="sh">
            <a class="sh__link" href="${h.url}">
              <span class="sh__title">${mark(h.title, term)}</span>
              <span class="sh__meta">${h.date}${h.tags.length ? ' · ' + esc(h.tags.slice(0, 2).join(' / ')) : ''}</span>
            </a>
          </li>`
        )
        .join('');
    };

    const clear = () => {
      hitsBox.hidden = true;
      hitsBox.innerHTML = '';
    };

    let timer = 0;
    const onInput = () => {
      const term = input.value.trim();
      window.clearTimeout(timer);
      if (!term) return clear();
      timer = window.setTimeout(async () => {
        const data = await load();
        const lower = term.toLowerCase();
        const hits = data.filter((h) =>
          [h.title, h.tags.join(' '), h.categories.join(' '), h.excerpt].join(' ').toLowerCase().includes(lower)
        );
        render(hits.slice(0, 5), term);
      }, 140);
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        input.value = '';
        clear();
        input.blur();
      }
    };

    /* ⌘K / Ctrl+K 直接聚焦到这张卡 */
    const onHotkey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
      }
    };

    const onOutside = (e: MouseEvent) => {
      if (!form.contains(e.target as Node)) clear();
    };

    input.addEventListener('input', onInput);
    input.addEventListener('keydown', onKey);
    window.addEventListener('keydown', onHotkey);
    document.addEventListener('click', onOutside);

    addCleanup(() => {
      window.clearTimeout(timer);
      input.removeEventListener('input', onInput);
      input.removeEventListener('keydown', onKey);
      window.removeEventListener('keydown', onHotkey);
      document.removeEventListener('click', onOutside);
    });
  });
</script>

<style>
  .bento {
    position: relative;
    width: min(var(--w-page), 100% - var(--s-6));
    margin-inline: auto;
    padding-block: var(--s-8) var(--s-9);
  }

  .bento__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--s-2) var(--s-5);
    margin-bottom: var(--s-6);
  }
  .bento__kicker {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: .18em;
    color: var(--ink-faint);
  }
  .bento__title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-2xl);
  }
  .bento__now {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--mint-deep);
    font-variant-numeric: tabular-nums;
  }

  .bento__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--glass-strong);
    border: 1px solid var(--glass-line);
    box-shadow: var(--shadow-card);
    backdrop-filter: var(--glass-blur);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .7s var(--ease-out), transform .7s var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .card.is-in { opacity: 1; transform: none; }
  .card:hover { box-shadow: var(--shadow-float); }

  .card__badge {
    margin: 0;
    align-self: flex-start;
    padding: 1px 10px;
    border-radius: var(--r-pill);
    background: var(--mint-soft);
    color: var(--mint-deep);
    font-size: 11px;
    letter-spacing: .12em;
  }
  .card--gallery .card__badge { background: var(--peach-soft); color: #b46a4a; }
  .card--plan .card__badge { background: var(--lilac); color: #5b5680; }
  .card--about .card__badge { background: var(--sun); color: #96702f; }
  .card--path .card__badge { background: var(--paper-3); color: var(--ink-soft); }

  .card__big {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-3xl);
    font-weight: 700;
    line-height: 1;
    color: var(--mint-deep);
  }
  .card__big em { font-size: var(--fs-sm); font-style: normal; color: var(--ink-faint); }
  .card__desc { margin: 0; font-size: var(--fs-xs); color: var(--ink-soft); line-height: 1.7; }

  .card__tags, .card__latest, .card__meta, .card__tasks {
    list-style: none; margin: 0; padding: 0;
  }
  .card__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .card__tags a {
    display: inline-flex; gap: 4px;
    padding: 1px 9px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .7);
    border: 1px solid var(--line);
    font-size: 11px;
    color: var(--ink-soft);
  }
  .card__tags span { color: var(--ink-faint); }

  .card__rhythm {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 92px;
    margin-top: var(--s-3);
    padding-bottom: 18px;
  }
  .rhythm { position: relative; flex: 1; height: 100%; display: flex; align-items: flex-end; }
  .rhythm i {
    display: block;
    width: 100%;
    height: max(6%, var(--h));
    border-radius: 6px 6px 3px 3px;
    background: linear-gradient(180deg, var(--mint), var(--mint-soft));
    opacity: .85;
  }
  .rhythm em {
    position: absolute;
    bottom: -18px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    font-style: normal;
    color: var(--ink-faint);
  }
  .card__rhythmlabel { margin: 0; font-size: 11px; color: var(--ink-faint); }

  .card__latest { display: flex; flex-direction: column; gap: 4px; margin-top: auto; padding-top: var(--s-3); border-top: 1px dashed var(--line); }
  .card__latest li { display: flex; justify-content: space-between; gap: var(--s-3); font-size: 11px; }
  .card__latest a { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .card__latest span { flex: none; color: var(--ink-faint); }

  .card__go {
    margin-top: auto;
    align-self: flex-start;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--mint-deep);
  }
  .card__go:hover { text-decoration: underline; }

  /* gallery shot */
  .card__shot {
    display: block;
    border-radius: var(--r-sm);
    overflow: hidden;
    margin-bottom: var(--s-2);
    background: var(--paper-3);
  }
  .card__shot :global(img) { display: block; width: 100%; height: 104px; object-fit: cover; }

  /* plan */
  .card__tasks { font-size: var(--fs-xs); line-height: 1.95; color: var(--ink-soft); }
  .card__tasks li::before { content: '□ '; }
  .card__tasks li.is-done { text-decoration: line-through; opacity: .5; }
  .card__tasks li.is-done::before { content: '✓ '; color: var(--mint-deep); }
  .card__tasks li.is-doing::before { content: '◐ '; color: var(--peach); }
  .card__progress { height: 5px; border-radius: var(--r-pill); background: rgba(52, 56, 63, .1); overflow: hidden; margin-top: var(--s-2); }
